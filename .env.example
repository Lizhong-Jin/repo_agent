# 任务目录的配置文件；由 run_agent.sh 加载，直接运行 repo-agent 不会加载。
# 优先级：命令行参数 > 已有非空环境变量 > 本文件 > 内置默认值。
# 修改后重新启动生效。值按字面量读取；允许成对引号，不展开变量和命令。
# 注释必须单独占一行。空值表示使用默认行为。

# 模型与服务地址
LLM_PROVIDER=deepseek
LLM_MODEL=replace-with-a-model-id-available-in-your-account
LLM_BASE_URL=
# 模型上下文窗口上限（token），按服务商实际限制填写；留空显示未知，不等于输出上限
LLM_CONTEXT_WINDOW=

# 每条任务的模型调用轮数上限、每次模型请求的输出 token 上限
AGENT_MAX_STEPS=8
AGENT_MAX_OUTPUT_TOKENS=4096

# 留空使用服务端默认温度；tool choice: auto / none / required
LLM_TEMPERATURE=
LLM_TOOL_CHOICE=auto

# 思考模式：auto=不指定开关，enabled=开启，disabled=关闭，adaptive=Claude 自适应
# 能力取决于具体模型；不支持的模式或强度可能被 API 拒绝。
LLM_THINKING=auto
# 可选强度：minimal / low / medium / high / xhigh / max；各厂商支持范围见 README
LLM_REASONING_EFFORT=
# 正整数；Claude 手动 enabled 必填，且 1024 <= 预算 < 输出上限。
# Qwen、Gemini 的预算支持取决于模型；其他厂商请留空。
LLM_THINKING_BUDGET=

# 流式接收；读取超时是等待首批数据或相邻数据的最长间隔，不是整次生成时长
LLM_STREAM=true
LLM_CONNECT_TIMEOUT=10
LLM_WRITE_TIMEOUT=30
LLM_POOL_TIMEOUT=10
# 读取等待（秒）、额外重试次数、重试基础间隔和最大间隔（秒）
LLM_TIMEOUT=300
LLM_MAX_RETRIES=2
LLM_RETRY_DELAY=0.5
LLM_MAX_RETRY_DELAY=30

# 留空使用内置提示词：完成修改后简短汇报，不重复贴出已写入文件的完整代码。
# 非空值会替换内置提示词；填写时必须为单行文本。
AGENT_SYSTEM_PROMPT=
# 对话和执行追踪日志目录；相对路径以启动目录为基准。执行统计只写日志。
AGENT_LOG_DIR=logs
# 高级厂商原生参数，JSON 对象；不能覆盖统一参数或与显式思考设置冲突
LLM_EXTRA_JSON={}

# Sandbox 回写：manual=手动 /apply；on-success=任务正常结束且执行检查通过后自动回写
# 默认手动。冲突、中断、超时或未解决失败不会自动覆盖原项目。
AGENT_SANDBOX_WRITEBACK=manual

# 默认使用流式接收；不支持流式的网关可设 LLM_STREAM=false。
# 仅填写所选厂商的 API Key

DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
MOONSHOT_API_KEY=
ZHIPU_API_KEY=
ARK_API_KEY=
MINIMAX_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# 可选：on-success 回写前的最终验证。JSON 参数数组，不解析 shell；在容器项目根目录运行，限时 120 秒。
# 留空不增加最终检查；失败保留副本，可修复后重新完成任务，或人工检查后 /apply。
# AGENT_SANDBOX_VERIFY_COMMAND='["python", "-m", "unittest", "discover"]'
AGENT_SANDBOX_VERIFY_COMMAND=
