# Repo Agent 默认配置；安装后编辑用户配置中的模型 ID 和对应 API Key 即可使用。
# repo-agent 自动加载用户配置和工作目录 .env；项目配置可覆盖用户配置。
# 优先级：命令行参数 > 已有非空环境变量 > 项目 .env > 用户配置 > 内置默认值。
# 修改后重新启动生效。值按字面量读取；允许成对引号，不展开变量和命令。
# 注释必须单独占一行。空值表示使用默认行为。

# 模型与服务地址
LLM_PROVIDER=
# 必填：填写账号实际可用的模型 ID
LLM_MODEL=
LLM_BASE_URL=
# 模型上下文窗口上限（token）；留空从当前服务端自动获取，未返回则显示未知
# 手动填写优先；用于占用显示与压缩预算，不等于输出上限
LLM_CONTEXT_WINDOW=

# 每条任务的模型调用轮数上限、每次模型请求的输出 token 上限
# AGENT_MAX_STEPS=0 表示轮数无上限；单次输出和连续恢复限制仍生效，可 Ctrl+C 中断
AGENT_MAX_STEPS=50
AGENT_MAX_OUTPUT_TOKENS=51200
# 连续截断最多额外恢复次数；0 关闭。恢复请求仍计入 AGENT_MAX_STEPS。
AGENT_MAX_RECOVERIES=2
# 工具参数截断时逐次翻倍的输出上限；必须 >= AGENT_MAX_OUTPUT_TOKENS。
# 留空不提高额度。仅在确认服务商/模型支持时填写更大的值。
AGENT_RECOVERY_MAX_OUTPUT_TOKENS=

# 留空使用服务端默认温度；tool choice: auto / none / required
LLM_TEMPERATURE=
LLM_TOOL_CHOICE=auto

# 思考内容显示：collapsed 折叠（默认） / expanded 展开 / hidden 隐藏区块。
# Ctrl+T 可在生成中展开/折叠；只影响界面，不调整模型强度或关闭思考。
AGENT_THINKING_DISPLAY=collapsed

# 思考模式：auto=不指定开关，enabled=开启，disabled=关闭，adaptive=Claude 自适应
# 能力取决于具体模型；不支持的模式或强度可能被 API 拒绝。
LLM_THINKING=auto
# 可选强度：minimal / low / medium / high / xhigh / max；各厂商支持范围见 docs/thinking.md
LLM_REASONING_EFFORT=
# 正整数；Claude 手动 enabled 必填，且 1024 <= 预算 < 输出上限。
# Qwen、Gemini 的预算支持取决于模型；其他厂商请留空。
LLM_THINKING_BUDGET=
# 历史思考保留：auto 沿用接口默认；on 保留；off 清除跨轮思考（仅已适配的 GLM 模型）。
LLM_THINKING_HISTORY=auto
# 交互切换按供应商＋接口地址＋模型保存；false 禁用保存和恢复。
LLM_THINKING_RECALL=true
# 可选模型能力覆盖 JSON，见 docs/thinking.md。不是请求体原生参数。
LLM_THINKING_PROFILE={}

# 流式接收；读取超时是等待首批数据或相邻数据的最长间隔，不是整次生成时长
LLM_STREAM=true
LLM_CONNECT_TIMEOUT=10
LLM_WRITE_TIMEOUT=30
LLM_POOL_TIMEOUT=10
# 读取等待（秒）、额外重试次数、重试基础间隔和最大间隔（秒）
LLM_TIMEOUT=300
LLM_MAX_RETRIES=2
LLM_RETRY_DELAY=0.5
LLM_MAX_RETRY_DELAY=30

# 留空使用通用系统提示词；编程编辑、测试及交付约定由按需加载的 coding 技能提供。
# 非空值会替换内置提示词；填写时必须为单行文本。
AGENT_SYSTEM_PROMPT=
# 运行片段追踪日志目录；相对路径以启动目录为基准。完整统计写日志，界面另显示用量与计时。
# 留空时使用工作目录下的 logs（包括通过 --root 指定的工作目录）
AGENT_LOG_DIR=
# 高级厂商原生参数，JSON 对象；不能覆盖统一参数或与显式思考设置冲突
LLM_EXTRA_JSON={}

# Sandbox 回写：manual=手动 /apply；on-success=任务正常结束且执行检查通过后自动回写
# 仅 --sandbox docker 使用此配置；默认 native 和显式 local 都直接修改原项目。
# 冲突、中断、超时或未解决失败不会自动覆盖原项目。
AGENT_SANDBOX_WRITEBACK=manual

# 主进程 Web 搜索：off（默认关闭）/ brave；不改变 native / Docker 命令断网策略。
# 启用后查询会发送给 Brave Search API。仅返回搜索摘要，不自动读取网页。
AGENT_WEB_SEARCH_PROVIDER=off
BRAVE_SEARCH_API_KEY=
# 独立启用公开网页读取（不需要搜索密钥）；URL 会发送给目标网站。
AGENT_WEB_FETCH_ENABLED=false

# 默认使用流式接收；不支持流式的网关可设 LLM_STREAM=false。
# 仅填写所选厂商的 API Key

DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
MOONSHOT_API_KEY=
ZHIPU_API_KEY=
ARK_API_KEY=
MINIMAX_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# 可选：on-success 回写前的最终验证。JSON 参数数组，不解析 shell；仅 Docker，在容器项目根目录运行；standard 上限 120 秒，cuda 上限 900 秒。
# 留空不增加最终检查；失败保留副本，可修复后重新完成任务，或人工检查后 /apply。
# AGENT_SANDBOX_VERIFY_COMMAND='["python", "-m", "unittest", "discover"]'
AGENT_SANDBOX_VERIFY_COMMAND=

# 上下文压缩：使用当前模型生成摘要，摘要请求用量计入会话总计。
# 阈值/目标相对于可用输入预算；完整窗口先减去本轮输出预留。
AGENT_AUTO_COMPACT=true
AGENT_COMPACT_THRESHOLD=0.75
AGENT_COMPACT_TARGET=0.45
AGENT_COMPACT_KEEP_TOKENS=6000
# 最终摘要正文目标；摘要请求沿用当前思考设置及 AGENT_MAX_OUTPUT_TOKENS 输出上限。
AGENT_COMPACT_SUMMARY_TOKENS=3000
