# Repo Agent 用户配置模板
# 首次安装复制此模板；重装按此模板重建，保留旧文件中仍有效的配置值（含空值）。
# 新增项使用模板值；模板中已移除的项丢弃，替换前自动备份旧文件。
# 优先级：命令行参数 > 非空环境变量 > 项目 .env > 用户配置 > 代码内置默认值。
# 修改后重新启动生效；repo-agent config show 查看合并后的值及来源。
# 值按字面量读取，不展开变量和命令；允许成对引号，注释必须单独占一行。
# 空值使用默认行为；项目中的显式空值还会清除同名用户配置。

# ── 模型与接口 ──
# 留空默认 deepseek；可选供应商及模型见 repo-agent config model。
LLM_PROVIDER=
# 必填：填写所选供应商的模型 ID；也可通过 config model 向导选择。
LLM_MODEL=
# 留空使用供应商预设 API 地址；自定义网关需与供应商协议匹配。
LLM_BASE_URL=

# ── 模型 API 密钥 ──
# 只需填写所选供应商的 Key；推荐使用 repo-agent config set KEY 隐藏输入。
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
MOONSHOT_API_KEY=
ZHIPU_API_KEY=
ARK_API_KEY=
MINIMAX_API_KEY=

# ── 任务与输出 ──
# 每条用户任务最多调用模型的轮数；0 表示无上限，可 Ctrl+C 中断。
# 安装模板为 50；显式留空时回退到代码内置值 8。
AGENT_MAX_STEPS=50
# 普通任务单次输出 token 上限；按模型能力调整，不代表模型最大输出能力。
AGENT_MAX_OUTPUT_TOKENS=4096
# 连续输出截断的额外恢复次数；0 关闭。恢复请求仍计入任务轮数。
AGENT_MAX_RECOVERIES=2
# 工具参数截断时逐次翻倍的输出额度上限；留空沿用原额度。
# 显式值须 >= AGENT_MAX_OUTPUT_TOKENS，且符合所选模型的输出上限。
AGENT_RECOVERY_MAX_OUTPUT_TOKENS=
# 默认流式接收；不支持流式的网关可设为 false。
LLM_STREAM=true
# 留空使用模型默认温度；显式值需符合模型能力。
LLM_TEMPERATURE=
# auto 自主选择工具 / none 禁用工具 / required 每轮必须调用工具。
LLM_TOOL_CHOICE=auto

# ── 思考与显示 ──
# auto 不指定开关 / enabled 开启 / disabled 关闭 / adaptive Claude 自适应。
# 模式、强度和预算必须符合所选模型；支持范围见 docs/thinking.md。
LLM_THINKING=auto
# 可选强度：minimal / low / medium / high / xhigh / max，留空不指定。
LLM_REASONING_EFFORT=
# 正整数；Claude 手动 enabled 需 1024 <= 预算 < 输出上限。
# Qwen、Gemini 的预算支持取决于模型；不支持预算的供应商请留空。
LLM_THINKING_BUDGET=
# GLM 历史思考保留：auto 沿用接口默认 / on 保留 / off 清除跨轮思考。
LLM_THINKING_HISTORY=auto
# 按供应商、接口地址和模型保存/恢复交互思考偏好；false 禁用。
LLM_THINKING_RECALL=true
# 可选模型能力覆盖 JSON，见 docs/thinking.md；不是请求体原生参数。
LLM_THINKING_PROFILE={}
# collapsed 折叠 / expanded 展开 / hidden 隐藏；Ctrl+T 可在生成中切换。
# 只影响界面，不改变模型思考强度或开关。
AGENT_THINKING_DISPLAY=collapsed

# ── 上下文与压缩 ──
# 上下文窗口上限（token）；留空优先查询服务端，其次使用模型目录。
# 两者均无数据时显示未知；手动填写优先，用于显示和压缩预算，不是输出上限。
LLM_CONTEXT_WINDOW=
# 正常请求前按预算自动压缩；false 关闭自动压缩，仍可手动 /compact。
AGENT_AUTO_COMPACT=true
# 阈值和目标相对于预留输出后的可用输入预算；须 0 < target < threshold < 1。
AGENT_COMPACT_THRESHOLD=0.75
AGENT_COMPACT_TARGET=0.45
# 近期完整消息组预算上限；实际保留量还受压缩目标预算限制。
AGENT_COMPACT_KEEP_TOKENS=6000
# 超目标后的额外精简轮数（0～4）；明显缩小且安全时可采纳超目标结果。
AGENT_COMPACT_MAX_REFINEMENTS=2
# 摘要请求不消耗任务轮数，用量计入会话总计；思考及输出额度使用模型目录的独立策略。

# ── 超时与重试 ──
# 以下超时单位为秒；读取超时指首批/相邻数据的等待间隔，不是整个任务时限。
LLM_TIMEOUT=300
LLM_CONNECT_TIMEOUT=10
LLM_WRITE_TIMEOUT=30
LLM_POOL_TIMEOUT=10
# 可重试 HTTP 错误的额外重试次数（0～10）；连接错误和超时不自动重试。
LLM_MAX_RETRIES=2
# 重试基础间隔与最大间隔（秒）。
LLM_RETRY_DELAY=0.5
LLM_MAX_RETRY_DELAY=30

# ── 联网工具 ──
# off 关闭 / brave 启用搜索；查询发送给 Brave，只返回摘要，不自动读取网页。
AGENT_WEB_SEARCH_PROVIDER=off
BRAVE_SEARCH_API_KEY=
# 独立启用公开网页读取，不需要搜索密钥；URL 会发送给目标网站。
# 这些工具在主进程联网，不改变 native / Docker 命令断网策略。
AGENT_WEB_FETCH_ENABLED=false

# ── 沙箱与回写 ──
# Linux native 隔离策略扫描：python 或 rust；选择 rust 前确认可选扩展安装成功。
# 源码安装尝试编译；发行包可附带预编译扩展；缺少扩展时继续使用 python。
AGENT_NATIVE_SCANNER=python
# 仅 Docker：manual 手动 /apply；on-success 任务成功且检查通过后自动回写。
# native / local 直接修改原项目；冲突、中断、超时或未解决失败不会自动回写。
AGENT_SANDBOX_WRITEBACK=manual
# on-success 回写前的最终验证命令：JSON 参数数组，不解析 shell，仅 Docker。
# 在容器项目根目录运行；standard 最长 120 秒，cuda 最长 900 秒。
# 留空不增加最终检查；示例值：'["python", "-m", "unittest", "discover"]'
AGENT_SANDBOX_VERIFY_COMMAND=

# ── 提示词与日志 ──
# 留空使用内置系统提示词；非空单行文本替换它，按需加载的 coding 技能仍可用。
AGENT_SYSTEM_PROMPT=
# 运行片段追踪日志目录；留空使用项目 logs/（含 --root 指定的项目）。
# 显式相对路径以启动目录为基准；不改变连续会话日志或快照位置。
AGENT_LOG_DIR=

# ── 高级请求参数 ──
# 厂商原生请求参数 JSON 对象；不能覆盖统一字段或与显式思考配置冲突。
LLM_EXTRA_JSON={}
