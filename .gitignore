# Python environments and generated bytecode
.venv/
venv/
__pycache__/
*.py[cod]

# Test, lint, and coverage output
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
/htmlcov/
/coverage.xml

# Build output (keep dependency lockfiles and build configuration tracked)
*.egg-info/
build/
dist/
node_modules/

# Generated offline Python materials; keep runtime/python.lock tracked
/runtime/python.tar.gz
/runtime/target
/wheelhouse/
/bundle.json
/.python-kit-*/

# Agent logs, including traces written to a custom log directory
logs/
*.trace.log
*.trace.jsonl

# Interrupted workspace writes and native sandbox probes (may appear in subdirectories)
.repo-agent-write-*
.native-probe-*

# Local configuration and backups; keep the public template
.env
.env.*
!.env.example

# Local diagnostics, test reports, and design proposals
/notes/

# Local installation ownership journal, lock, and recovery state
.repo-agent-install.json
.repo-agent-operation.lock
.repo-agent-install-transaction/
/.install-*

# OS metadata and editor temporary files (keep shared editor configuration)
.DS_Store
._*
*.swp
*.swo
*~

# Rust scanner build outputs; Cargo.lock remains tracked
/rust/**/target/
/rust_wheels/
